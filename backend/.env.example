# =========================================================================
# Backend-specific overrides. Most backend settings live in the ROOT .env.
# Copy to "backend/.env" only if you need to override values here.
# NEVER commit the real "backend/.env".
# =========================================================================

# ── SendGrid (optional alternative to Gmail SMTP for OTP emails) ─────────
# By default the app uses Gmail SMTP (see root .env). To use SendGrid instead,
# set these and configure the app to prefer SendGrid.
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=verified-sender@example.com
