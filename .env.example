# =========================================================================
# Cricket Analytics — root environment variables (backend + Flask)
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# =========================================================================

# ── RapidAPI (Cricbuzz live-cricket feed) ────────────────────────────────
# Get a key at https://rapidapi.com/  (subscribe to the Cricbuzz Cricket API)
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com
RUN_LIVE_API_TESTS=false

# ── FastAPI settings ─────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# In production, list your real frontend domain(s), e.g. https://your-app.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default IPL season used when not supplied in a request
DEFAULT_SEASON=2024

# RapidAPI request timeout (seconds)
API_TIMEOUT_SECONDS=10

# API key protecting FastAPI endpoints. Use a strong random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=generate-a-strong-random-string

# ── Flask settings (Phase 1/2 app.py) ────────────────────────────────────
FLASK_DEBUG=false
FLASK_PORT=5000
MAX_UPLOAD_MB=100

# ── Email delivery (OTP / password-reset emails via Gmail SMTP) ──────────
# SMTP_PASSWORD must be a 16-char Gmail App Password (no spaces), created at
# https://myaccount.google.com/apppasswords  — NOT your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=CricShift

# Secret used to sign short-lived password-reset / auth tokens.
# Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# ── Google Sign-In (OAuth) — optional ────────────────────────────────────
# Create an OAuth 2.0 "Web application" Client ID at
# https://console.cloud.google.com/apis/credentials and add your frontend
# origin under "Authorized JavaScript origins". Leave blank to disable Google.
GOOGLE_CLIENT_ID=

# ── Admin access control ─────────────────────────────────────────────────
# Comma-separated emails granted admin access to /admin. Everyone else is a
# regular user. Example: you@example.com,teammate@example.com
ADMIN_EMAILS=you@example.com
