// CricShift — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Changed from "sqlite" to "postgresql" for Render production.
  // DATABASE_URL must be set in the environment (e.g. Render → Environment Variables).
  // Use the "Internal Database URL" from your Render PostgreSQL instance for
  // services running in the same Render region, or the "External Database URL"
  // for external access. Never expose credentials in NEXT_PUBLIC_* variables.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
// Stores all registered users. Passwords are bcrypt-hashed server-side.
// Mobile is optional; used for OTP-based password reset.
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String

  // Optional — unique when set (null values do not violate the unique constraint
  // in PostgreSQL, unlike SQLite which treats multiple NULLs as duplicates).
  mobile         String?   @unique

  // Access role: "user" (default) or "admin".
  // Admins are also derived from the ADMIN_EMAILS env var on the backend.
  role           String    @default("user")

  // OTP reset fields — cleared after use
  otpCode        String?
  otpExpiry      DateTime?
  otpMobile      String?

  // Face Lock: JSON array of 128-float face descriptors registered by an admin.
  // Stored as TEXT so there is no length cap (PostgreSQL TEXT is unlimited).
  // Null = no face set up. Never stores images.
  faceDescriptors String?  @db.Text

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]

  @@map("users")
}

// ── Sessions ──────────────────────────────────────────────────────────────────
// Simple token-based sessions. Each login creates a row; logout deletes it.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}
