# =========================================================================
# CricShift frontend (Next.js) environment variables.
# Copy the relevant values into ".env" and/or ".env.local".
# NEVER commit real ".env" / ".env.local" files.
# =========================================================================

# ── Prisma database connection (used by prisma db push / migrate) ────────
# Local dev uses a SQLite file. In production use a managed database URL, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=file:../db/custom.db

# ── Backend API base URL (exposed to the browser) ────────────────────────
# Local dev points to the FastAPI backend on 127.0.0.1:8000.
# In production set this to your deployed backend URL, e.g. https://api.your-app.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
